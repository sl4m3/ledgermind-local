{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ledgermind.local/schemas/hypothesis-response-v1.schema.json",
  "title": "LedgerMind Hypothesis Response v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["hypotheses"],
  "properties": {
    "hypotheses": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "target", "statement", "rationale", "result", "artifacts", "source_event_ids"],
        "properties": {
          "title": {"type": "string", "minLength": 1, "maxLength": 240},
          "target": {"type": "string", "minLength": 1, "maxLength": 240},
          "statement": {"type": "string", "minLength": 1, "maxLength": 20000},
          "rationale": {"type": "string", "maxLength": 40000},
          "result": {"type": "string", "maxLength": 20000},
          "artifacts": {"type": "array", "maxItems": 500, "items": {"type": "string"}},
          "source_event_ids": {"type": "array", "minItems": 1, "maxItems": 1000, "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
